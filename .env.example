# Nur eine Vorlage. Den echten Token ausschließlich geschützt hinterlegen.
GOR_DISCORD_BOT_TOKEN=
GOR_DATA_DIR=./betrieb
GOR_SUPPORT_ENABLED=false
PORT=8080

# Öffentliche, tatsächlich vorhandene Seiten; alternativ als Inhaber über /einrichtung hinterlegen.
GOR_IMPRESSUM_URL=
GOR_PRIVACY_URL=
GOR_CONTACT_URL=
GOR_PAYMENT_SUPPORT_URL=
GOR_APPEAL_URL=
# Nur konkret benannte Discord-Nutzer-IDs, mit Komma getrennt; keine automatische Teamfreigabe.
GOR_PRIVACY_USER_IDS=

# Optional: vorhandenes unabhängiges Sicherungsziel. Keine neue Infrastruktur wird angelegt.
# Erst nach tatsächlicher Prüfung von Ziel, Vertragsrolle und Datenübermittlung aktivieren.
GOR_BACKUP_REMOTE_APPROVED=false
GOR_BACKUP_KEY=
GOR_BACKUP_S3_BUCKET=
GOR_BACKUP_S3_ENDPOINT=
GOR_BACKUP_S3_ACCESS_KEY=
GOR_BACKUP_S3_SECRET_KEY=
GOR_BACKUP_S3_REGION=
